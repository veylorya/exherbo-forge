function PARTITIONING_USE_SWAP_tag()   { echo " ├ Use swap"; }
function PARTITIONING_USE_SWAP_label() { on_off_label "$PARTITIONING_USE_SWAP" " ├ "; }
function PARTITIONING_USE_SWAP_show()  { [[ $PARTITIONING_SCHEME != "custom" && $PARTITIONING_SCHEME != "manual" ]]; }
function PARTITIONING_USE_SWAP_help()  { echo "Select whether or not to create a swap partition."; }
function PARTITIONING_USE_SWAP_menu()  {
	on_off_toggle "PARTITIONING_USE_SWAP"
	UNSAVED_CHANGES=true
}

function PARTITIONING_SWAP_tag()   { echo " │  └ Swap amount"; }
function PARTITIONING_SWAP_label() {
	if [[ $PARTITIONING_SWAP == "auto" ]]; then
		echo " │  └ (automatic: $(format_mib "$(plan_swap_mib auto)"))"
	else
		echo " │  └ ($PARTITIONING_SWAP)"
	fi
}
function PARTITIONING_SWAP_show()  { [[ $PARTITIONING_SCHEME != "custom" && $PARTITIONING_SCHEME != "manual" ]] && is_on "$PARTITIONING_USE_SWAP" && ! one_of "$PARTITIONING_SCHEME" "existing_partitions"; }
function PARTITIONING_SWAP_help()  { echo "How much swap to create. 'Automatic' sizes it from the RAM of this machine: twice the RAM for up to 2 GiB, as much as the RAM up to 8 GiB, and 8 GiB above that. Swap also helps when compiling large packages."; }
function PARTITIONING_SWAP_menu()  {
	local mode="custom"
	[[ $PARTITIONING_SWAP == "auto" ]] && mode="auto"
	menu_radiolist_labeled \
		"Swap size" \
		"How big should the swap partition be?" \
		"$mode" \
		"auto"   "Automatic, based on RAM ($(format_mib "$(plan_swap_mib auto)") on this machine)" \
		"custom" "Custom size" \
		|| return 0
	if [[ $dialog_out == "auto" ]]; then
		PARTITIONING_SWAP="auto"
		UNSAVED_CHANGES=true
		return 0
	fi
	local default="$PARTITIONING_SWAP"
	[[ $default == "auto" ]] && default="8GiB"
	while true; do
		dialog \
			--title "Swap size" \
			--inputbox "Enter the amount of swap for the new system, with a unit (e.g. 16GiB, 4096MiB)." \
			"${INPUTBOX_SIZE[@]}" "$default" \
			|| return 0
		if size_to_mib "$dialog_out" >/dev/null; then
			PARTITIONING_SWAP="$dialog_out"
			UNSAVED_CHANGES=true
			return 0
		fi
		default="$dialog_out"
		dialog --msgbox "'$dialog_out' is not a valid size. Use a number with a unit, like 8GiB or 512MiB." 7 60
	done
}


function PARTITIONING_SWAP_DEVICE_tag()   { echo " │  └ Swap Device"; }
function PARTITIONING_SWAP_DEVICE_label() {
