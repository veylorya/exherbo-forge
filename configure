function desktop_name() {
	case "$DESKTOP" in
		none)   echo "none (console only)" ;;
		plasma) echo "KDE Plasma" ;;
	esac
}

function DESKTOP_tag()   { echo "Desktop environment"; }
function DESKTOP_label() { echo "($(desktop_name))"; }
function DESKTOP_show()  { return 0; }
function DESKTOP_help()  { echo "Installs KDE Plasma with 'cave resolve plasma' (the documented Exherbo way) and KDE's Plasma Login Manager as the login screen. Exherbo has no binary packages, so this compiles hundreds of packages and can take a day on a slow machine. Choose 'None' to get a minimal system first and add a desktop later with cave."; }
function DESKTOP_menu()  {
	local prev_desktop="$DESKTOP"
	if menu_radiolist_labeled \
		"Desktop environment" \
		"Select the desktop environment to install." \
		"$DESKTOP" \
		"none"   "None - console only (minimal system)" \
		"plasma" "KDE Plasma - compiled from source, takes many hours"
	then
		DESKTOP="$dialog_out"
		UNSAVED_CHANGES=true
		[[ $DESKTOP == "none" ]] && DISPLAY_MANAGER="auto"
		if [[ $DESKTOP != "none" && $NETWORK_BACKEND != "networkmanager" ]]; then
			if dialog --yesno "Desktops are easiest to use with NetworkManager (graphical Wi-Fi/VPN settings). Switch the network setup to NetworkManager?" 8 64; then
				NETWORK_BACKEND="networkmanager"
			fi
		fi
	fi
}

function DISPLAY_MANAGER_tag()   { echo " ├ Login screen (greeter)"; }
function DISPLAY_MANAGER_label() { echo " ├ ($(display_manager_name))"; }
function DISPLAY_MANAGER_show()  { [[ $DESKTOP != "none" ]]; }
function display_manager_name() {
	case "$DISPLAY_MANAGER" in
		auto)
			case "$DESKTOP" in
				plasma) echo "auto: Plasma Login Manager" ;;
				*)      echo "auto" ;;
			esac ;;
		plasmalogin)    echo "Plasma Login Manager" ;;
		sddm)           echo "SDDM" ;;
	esac
}
function DISPLAY_MANAGER_help()  { echo "The graphical login screen. Automatic uses KDE's Plasma Login Manager (kde/plasma-login-manager) and falls back to SDDM if that cannot be installed. If no login screen can be installed, the system boots to a text login and 'startplasma-wayland' can be started by hand."; }
function DISPLAY_MANAGER_menu()  {
	local items=(
		"auto"        "Automatic (Plasma Login Manager, SDDM as fallback)"
		"plasmalogin" "Plasma Login Manager (KDE's login screen)"
		"sddm"        "SDDM (only if your repositories provide it)"
	)
	if menu_radiolist_labeled \
		"Login screen" \
		"Select the graphical login screen (display manager / greeter)." \
		"$DISPLAY_MANAGER" \
		"${items[@]}"
	then
		DISPLAY_MANAGER="$dialog_out"
		UNSAVED_CHANGES=true
	fi
}

