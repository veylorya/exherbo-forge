#MENU_SIZE=("20" "76" "12")
#INPUTBOX_SIZE=("11" "76")
#EDITTEXT_SIZE=("16" "76")
#RADIOLIST_SIZE=("20" "76" "8")
#BUILDLIST_SIZE=("20" "76" "8")
#HELP_POPUP_SIZE=("8" "66")
#CONFIRM_SIZE=("8" "66")
init_menu_size


################################################
# Partition planning helpers (sizes, preview, validation)

# $1: size like 8GiB, 512MiB, 1G, 1.5TiB -> integer MiB
function size_to_mib() {
	local s="$1" num unit
	[[ $s =~ ^([0-9]+(\.[0-9]+)?)(K|M|G|T|KiB|MiB|GiB|TiB)$ ]] || return 1
	num="${BASH_REMATCH[1]}"
	unit="${BASH_REMATCH[3]}"
	case "$unit" in
		K|KiB) awk -v n="$num" 'BEGIN { printf "%d", n / 1024 }' ;;
		M|MiB) awk -v n="$num" 'BEGIN { printf "%d", n }' ;;
		G|GiB) awk -v n="$num" 'BEGIN { printf "%d", n * 1024 }' ;;
		T|TiB) awk -v n="$num" 'BEGIN { printf "%d", n * 1024 * 1024 }' ;;
	esac
}

# $1: MiB -> "1.5 GiB"
function format_mib() {
	awk -v m="$1" 'BEGIN {
		if (m >= 1048576) printf "%.1f TiB", m / 1048576;
		else if (m >= 1024) printf "%.1f GiB", m / 1024;
		else printf "%d MiB", m }'
}

# $1: device -> size in MiB (fails if the device does not exist)
function disk_size_mib() {
	local bytes
	[[ -b $1 ]] || return 1
	bytes="$(lsblk -bdno SIZE "$1" 2>/dev/null | head -n 1 | tr -d '[:space:]')"
	[[ $bytes =~ ^[0-9]+$ ]] || return 1
	echo -n "$((bytes / 1048576))"
}

# Swap size in MiB for a PARTITIONING_SWAP value (auto: depends on the RAM of this machine,
# the same rule as the installer uses)
function plan_swap_mib() {
	local kb gib
	if [[ $1 == "auto" ]]; then
		kb="$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo 2>/dev/null)"
		gib=$(( (${kb:-0} + 1048575) / 1048576 ))
		[[ $gib -lt 1 ]] && gib=1
		if [[ $gib -le 2 ]]; then
			echo -n "$(( (gib * 2 > 2 ? gib * 2 : 2) * 1024 ))"
		elif [[ $gib -le 8 ]]; then
			echo -n "$((gib * 1024))"
		else
			echo -n 8192
		fi
	else
		size_to_mib "$1"
	fi
}

# Default partition list for the custom partitioning editor: swap + root (btrfs) taking the rest.
# $1: device (only used to look at its size)
function manual_default_parts() {
	echo -n "$(format_mib "$(plan_swap_mib auto)" | sed -e 's/\.0 / /' -e 's/ //'):swap:swap;remaining:/:ext4"
}

# Fills PLAN_PROBLEMS with everything that is wrong with the manual partition list.
function manual_validate() {
	PLAN_PROBLEMS=()
	local size_re='^([0-9]+(\.[0-9]+)?(K|M|G|T|KiB|MiB|GiB|TiB)|remaining)$'
	local mp_re='^/[A-Za-z0-9._/-]*$'
	local row size mount fs luks have_root=false have_swap=false saw_remaining=false
	local -A seen=()
	for row in "${PARTITIONING_MANUAL_PARTS[@]}"; do
		size="" mount="" fs="" luks=""
		IFS=':' read -r size mount fs luks <<< "$row"
		[[ $saw_remaining == false ]] || PLAN_PROBLEMS+=("'$mount' comes after the 'remaining' partition; only the last partition can take the rest.")
		[[ $size =~ $size_re ]] || PLAN_PROBLEMS+=("'$size' is not a valid size (use e.g. 512MiB, 8GiB or remaining).")
		[[ $size == remaining ]] && saw_remaining=true
		case "$fs" in ext4|btrfs|swap) ;; *) PLAN_PROBLEMS+=("Unsupported filesystem '$fs' for '$mount'.") ;; esac
		if [[ $mount == swap ]]; then
			[[ $have_swap == false ]] || PLAN_PROBLEMS+=("Only one swap partition is supported.")
			have_swap=true
		else
			[[ $mount =~ $mp_re ]] || PLAN_PROBLEMS+=("'$mount' is not a valid mountpoint.")
			[[ $mount != /boot && $mount != /boot/* ]] || PLAN_PROBLEMS+=("'$mount' is the boot partition, which the installer manages itself.")
			[[ ! -v seen[$mount] ]] || PLAN_PROBLEMS+=("Mountpoint '$mount' is used twice.")
			seen[$mount]=true
			[[ $mount == "/" ]] && have_root=true
			[[ -z $luks || $mount == "/" ]] || PLAN_PROBLEMS+=("Only the root partition can be encrypted ('$mount').")
		fi
	done
	[[ $have_root == true ]] || PLAN_PROBLEMS+=("There is no root ('/') partition.")

	local disk_mib total=0
	if disk_mib="$(disk_size_mib "$PARTITIONING_DEVICE")"; then
		total="$(size_to_mib "$PARTITIONING_MANUAL_BOOT_SIZE" || echo 0)"
		for row in "${PARTITIONING_MANUAL_PARTS[@]}"; do
			IFS=':' read -r size _ <<< "$row"
			[[ $size == remaining ]] && continue
			total=$((total + $(size_to_mib "$size" || echo 0)))
		done
		[[ $total -lt $disk_mib ]] || PLAN_PROBLEMS+=("The partitions (${total} MiB) do not fit on the disk ($(format_mib "$disk_mib")).")
	fi
}

# Prints a table describing what the selected scheme will do to the disk.
function partition_plan_text() {
	PLAN_PROBLEMS=()
	local dev="${PARTITIONING_DEVICE:-}"
	local disk_mib="" disk_desc="(no disk selected)"
	if [[ -n $dev ]] && disk_mib="$(disk_size_mib "$dev")"; then
		disk_desc="$(shorten_device "$dev")  ·  $(format_mib "$disk_mib")"
	elif [[ -n $dev ]]; then
		disk_desc="$(shorten_device "$dev")  ·  size unknown (device not found)"
		disk_mib=""
	fi

	local boot_label="EFI system partition" boot_fs="FAT32" boot_mount="/boot"
	if [[ $PARTITIONING_BOOT_TYPE == "bios" ]]; then
		boot_label="BIOS boot (syslinux)"
		boot_mount="/boot/bios"
	fi

	local rows=() # role|size_mib|fs|mount|note
	local details=()
	local used=0 mib
	case "$PARTITIONING_SCHEME" in
		classic_single_disk|manual)
			if [[ $PARTITIONING_SCHEME == "manual" ]]; then
				mib="$(size_to_mib "$PARTITIONING_MANUAL_BOOT_SIZE" || echo 1024)"
			else
				mib=1024
			fi
			rows+=("$boot_label|$mib|$boot_fs|$boot_mount|")
			used=$mib
			if [[ $PARTITIONING_SCHEME == "classic_single_disk" ]]; then
				if is_on "$PARTITIONING_USE_SWAP"; then
					mib="$(plan_swap_mib "$PARTITIONING_SWAP" || echo 0)"
					rows+=("Swap|$mib|swap|—|")
					used=$((used + mib))
				fi
				local note=""
				is_on "$PARTITIONING_USE_LUKS" && { note="LUKS"; details+=("Root is encrypted with LUKS (you enter the passphrase at boot)."); }
				if [[ $PARTITIONING_ROOT_FS == "btrfs" ]] && is_on "$PARTITIONING_BTRFS_SUBVOLUMES"; then
					details+=("Btrfs subvolumes: / (root), /home, /.snapshots, /var/log, /var/cache.")
				fi
				rows+=("Root|rest|$PARTITIONING_ROOT_FS|/|$note")
			else
				local row size mount fs luks label
				for row in "${PARTITIONING_MANUAL_PARTS[@]}"; do
					size="" mount="" fs="" luks=""
					IFS=':' read -r size mount fs luks <<< "$row"
					if [[ $mount == swap ]]; then label="Swap"; elif [[ $mount == / ]]; then label="Root"; else label="Data"; fi
					mib="rest"
					if [[ $size != remaining ]]; then
						mib="$(size_to_mib "$size" || echo 0)"
						used=$((used + mib))
					fi
					rows+=("$label|$mib|$fs|$([[ $mount == swap ]] && echo "—" || echo "$mount")|${luks:+LUKS}")
					[[ -z $luks ]] || details+=("Root is encrypted with LUKS (you enter the passphrase at boot).")
				done
				manual_validate
			fi
			;;
	esac

	local total_note=""
	if [[ $PARTITIONING_SCHEME == "classic_single_disk" || $PARTITIONING_SCHEME == "manual" ]]; then
		if [[ -z $dev || ! -e $dev ]]; then
			PLAN_PROBLEMS+=("The target disk '${dev:-none}' does not exist. Choose it with 'Device'.")
		elif [[ -n $disk_mib ]]; then
			local rest=$((disk_mib - used - 2))
			if [[ $rest -lt 1024 && $PARTITIONING_SCHEME == "classic_single_disk" ]]; then
				PLAN_PROBLEMS+=("Not enough space: only $(format_mib "$rest") would remain for the root filesystem. A desktop needs 30 GiB or more.")
			elif [[ $rest -lt 8192 && $PARTITIONING_SCHEME == "classic_single_disk" ]]; then
				PLAN_PROBLEMS+=("Only $(format_mib "$rest") remain for the root filesystem; a desktop install needs about 30 GiB.")
			fi
			local r i
			for i in "${!rows[@]}"; do
				IFS='|' read -r label mib _ <<< "${rows[$i]}"
				if [[ $mib == rest ]]; then
					rows[i]="${rows[$i]/|rest|/|$rest|}"
				fi
			done
		fi
	fi

	if [[ ${#rows[@]} -gt 0 ]]; then
		printf '  Disk   %s  ·  GPT  ·  %s\n\n' "$disk_desc" "$([[ $PARTITIONING_BOOT_TYPE == efi ]] && echo "EFI boot" || echo "BIOS boot")"
		printf '  %-3s %-22s %-10s %-6s %-14s %s\n' "#" "Partition" "Size" "FS" "Mount" "Notes"
		printf '  %s\n' "──────────────────────────────────────────────────────────────────────────────"
		local n=0 label mib2 fs mount note shown
		for r in "${rows[@]}"; do
			n=$((n + 1))
			IFS='|' read -r label mib2 fs mount note <<< "$r"
			if [[ $mib2 == rest ]]; then shown="rest"; else shown="$(format_mib "$mib2")"; fi
			printf '  %-3s %-22s %-10s %-6s %-14s %s\n' "$n" "$label" "$shown" "$fs" "$mount" "$note"
		done
		local d
		for d in "${details[@]}"; do printf '\n  • %s' "$d"; done
		printf '\n\n  The whole disk is erased and repartitioned (GPT).\n  Nothing happens until you confirm the plan.\n'
	else
		case "$PARTITIONING_SCHEME" in
			existing_partitions)
				printf '  Existing partitions are used as they are (nothing is repartitioned or formatted).\n\n  Root: %s\n  Boot: %s\n  Swap: %s\n' \
					"$PARTITIONING_DEVICE" "$PARTITIONING_BOOT_DEVICE" "$([[ $PARTITIONING_USE_SWAP == true ]] && echo "${PARTITIONING_SWAP_DEVICE:-none}" || echo none)" ;;
			zfs_centric)
				printf '  ZFS: %s device(s), pool type %s, encryption %s, compression %s.\n  Layout: boot (1 GiB)%s on the first disk, the rest goes to the pool.\n' \
					"${#PARTITIONING_DEVICES[@]}" "$PARTITIONING_ZFS_POOL_TYPE" "$PARTITIONING_ZFS_USE_ENCRYPTION" "$([[ $PARTITIONING_ZFS_USE_COMPRESSION == true ]] && echo "$PARTITIONING_ZFS_COMPRESSION" || echo off)" \
					"$([[ $PARTITIONING_USE_SWAP == true ]] && echo ", swap ($PARTITIONING_SWAP)")" ;;
			btrfs_centric)
				printf '  Btrfs across %s device(s), raid type %s%s.\n  Layout: boot (1 GiB)%s on the first disk, the rest forms the btrfs array.\n' \
					"${#PARTITIONING_DEVICES[@]}" "$PARTITIONING_BTRFS_RAID_TYPE" "$([[ $PARTITIONING_USE_LUKS == true ]] && echo ", LUKS encrypted")" \
					"$([[ $PARTITIONING_USE_SWAP == true ]] && echo ", swap ($PARTITIONING_SWAP)")" ;;
			raid0_luks)
				printf '  Raid0 across %s device(s) with LUKS, root filesystem %s.\n  Layout: boot (1 GiB) on the first disk, swap raid0%s, root raid0 + LUKS.\n' \
					"${#PARTITIONING_DEVICES[@]}" "$PARTITIONING_ROOT_FS" "$([[ $PARTITIONING_USE_SWAP == true ]] && echo " ($PARTITIONING_SWAP each)")" ;;
			custom)
				printf '  The disk layout is defined by the disk_configuration function in your config file.\n' ;;
		esac
	fi

	if [[ ${#PLAN_PROBLEMS[@]} -gt 0 ]]; then
		printf '\n  !! Problems:\n'
		local pr
		for pr in "${PLAN_PROBLEMS[@]}"; do printf '     - %s\n' "$pr"; done
	fi
}

function show_partition_plan() {
	local text
	text="$(partition_plan_text)"
	dialog --title " Disk layout preview " --no-collapse --ok-label "Close" \
		--msgbox "$text" "$((MENU_SIZE[0] > 22 ? 22 : MENU_SIZE[0]))" "${MENU_SIZE[1]}"
}


################################################
# Custom partitioning editor

MANUAL_MOUNT_CHOICES=("/" "swap" "/home" "/var" "/opt" "/srv" "/data" "<custom>")

function manual_row_get() { # idx field(1-4)
	local row="${PARTITIONING_MANUAL_PARTS[$1]}"
	local f1 f2 f3 f4
	IFS=':' read -r f1 f2 f3 f4 <<< "$row"
	case "$2" in 1) echo -n "$f1" ;; 2) echo -n "$f2" ;; 3) echo -n "$f3" ;; 4) echo -n "$f4" ;; esac
}

function manual_row_set() { # idx size mount fs luks
	PARTITIONING_MANUAL_PARTS[$1]="$2:$3:$4:$5"
	PARTITIONING_MANUAL_PARTS[$1]="${PARTITIONING_MANUAL_PARTS[$1]%:}"
	UNSAVED_CHANGES=true
}

# $1: current mountpoint. Sets dialog_out. Returns 1 on cancel.
function manual_pick_mount() {
	local items=() m
	for m in "${MANUAL_MOUNT_CHOICES[@]}"; do
		case "$m" in
			"/")        items+=("/" "/  (root, required)") ;;
			"swap")     items+=("swap" "swap space") ;;
			"/home")    items+=("/home" "/home  (user files)") ;;
			"/var")     items+=("/var" "/var  (logs, caches, databases)") ;;
			"/opt")     items+=("/opt" "/opt") ;;
			"/srv")     items+=("/srv" "/srv  (served data)") ;;
			"/data")    items+=("/data" "/data  (extra storage)") ;;
			"<custom>") items+=("<custom>" "Other mountpoint…") ;;
		esac
	done
	menu_radiolist_labeled "Mountpoint" "Where should this partition be mounted?" "$1" "${items[@]}" || return 1
	if [[ $dialog_out == "<custom>" ]]; then
		dialog --title "Mountpoint" --inputbox "Enter an absolute mountpoint (e.g. /mnt/games). /boot is managed by the installer." \
			"${INPUTBOX_SIZE[@]}" "/" || return 1
		[[ $dialog_out =~ ^/[A-Za-z0-9._/-]*$ ]] || { dialog --msgbox "'$dialog_out' is not a valid mountpoint." 7 50; return 1; }
	fi
	return 0
}

function manual_pick_size() { # current default
	while true; do
		dialog --title "Partition size" \
			--inputbox "Size of the partition, e.g. 512MiB, 8GiB, 1.5TiB. Enter 'remaining' to use all remaining space (only possible for the last partition)." \
			"${INPUTBOX_SIZE[@]}" "$1" || return 1
		if [[ $dialog_out == remaining ]] || size_to_mib "$dialog_out" >/dev/null; then
			return 0
		fi
		dialog --msgbox "'$dialog_out' is not a valid size. Use a number with a unit, like 8GiB or 512MiB." 7 60
		set -- "$dialog_out"
	done
}

function manual_pick_fs() { # current
	menu_radiolist_labeled "Filesystem" "Select the filesystem for this partition." "$1" \
		"ext4"  "ext4  (robust, simple)" \
		"btrfs" "btrfs (compression, snapshots)"
}

function manual_add_partition() {
	manual_pick_mount "/home" || return 0
	local mount="$dialog_out" size fs
	if [[ $mount == swap ]]; then
		fs=swap
		size="$(format_mib "$(plan_swap_mib auto)" | sed -e 's/\.0 / /' -e 's/ //')"
	else
		manual_pick_fs ext4 || return 0
		fs="$dialog_out"
		size=remaining
	fi
	manual_pick_size "$size" || return 0
	size="$dialog_out"
	local i
	PARTITIONING_MANUAL_PARTS+=("$size:$mount:$fs")
	# Keep a 'remaining' partition at the end
	for i in "${!PARTITIONING_MANUAL_PARTS[@]}"; do
		if [[ ${PARTITIONING_MANUAL_PARTS[$i]} == remaining:* && $i -ne $((${#PARTITIONING_MANUAL_PARTS[@]} - 1)) ]]; then
			local moved="${PARTITIONING_MANUAL_PARTS[$i]}"
			unset "PARTITIONING_MANUAL_PARTS[$i]"
			PARTITIONING_MANUAL_PARTS=("${PARTITIONING_MANUAL_PARTS[@]}" "$moved")
			break
		fi
	done
	UNSAVED_CHANGES=true
}

function manual_edit_row() { # idx
	local idx="$1" choice
	while true; do
		[[ -v PARTITIONING_MANUAL_PARTS[$idx] ]] || return 0
		local size mount fs luks
		size="$(manual_row_get "$idx" 1)"; mount="$(manual_row_get "$idx" 2)"
		fs="$(manual_row_get "$idx" 3)"; luks="$(manual_row_get "$idx" 4)"
		local items=(
			"size"   "Size            ($size)"
			"mount"  "Mountpoint      ($mount)"
		)
		[[ $mount == swap ]] || items+=("fs" "Filesystem      ($fs)")
		[[ $mount == "/" ]] && items+=("luks" "Encryption      ($([[ $luks == luks ]] && echo "LUKS on" || echo off))")
		items+=("up" "Move up" "down" "Move down" "delete" "Delete this partition" "back" "« Back")
		dialog --title " Partition: $mount " --no-tags --cancel-label "Back" --menu "Edit this partition." \
			"$((${#items[@]} / 2 + 7))" 52 "$((${#items[@]} / 2))" "${items[@]}" || return 0
		choice="$dialog_out"
		case "$choice" in
			size)   manual_pick_size "$size" && manual_row_set "$idx" "$dialog_out" "$mount" "$fs" "$luks" ;;
			mount)
				if manual_pick_mount "$mount"; then
					local nm="$dialog_out" nfs="$fs" nluks="$luks"
					if [[ $nm == swap ]]; then nfs=swap; nluks=""; elif [[ $fs == swap ]]; then nfs=ext4; fi
					[[ $nm == "/" ]] || nluks=""
					manual_row_set "$idx" "$size" "$nm" "$nfs" "$nluks"
				fi ;;
			fs)     manual_pick_fs "$fs" && manual_row_set "$idx" "$size" "$mount" "$dialog_out" "$luks" ;;
			luks)   manual_row_set "$idx" "$size" "$mount" "$fs" "$([[ $luks == luks ]] && echo "" || echo luks)" ;;
			up)
				if [[ $idx -gt 0 ]]; then
					local tmp="${PARTITIONING_MANUAL_PARTS[$((idx - 1))]}"
					PARTITIONING_MANUAL_PARTS[$((idx - 1))]="${PARTITIONING_MANUAL_PARTS[$idx]}"
					PARTITIONING_MANUAL_PARTS[$idx]="$tmp"
					UNSAVED_CHANGES=true
					idx=$((idx - 1))
				fi ;;
			down)
				if [[ $idx -lt $((${#PARTITIONING_MANUAL_PARTS[@]} - 1)) ]]; then
					local tmp2="${PARTITIONING_MANUAL_PARTS[$((idx + 1))]}"
					PARTITIONING_MANUAL_PARTS[$((idx + 1))]="${PARTITIONING_MANUAL_PARTS[$idx]}"
					PARTITIONING_MANUAL_PARTS[$idx]="$tmp2"
					UNSAVED_CHANGES=true
					idx=$((idx + 1))
				fi ;;
			delete)
				if dialog --defaultno --yesno "Delete the partition '$mount'?" 7 50; then
					unset "PARTITIONING_MANUAL_PARTS[$idx]"
					PARTITIONING_MANUAL_PARTS=("${PARTITIONING_MANUAL_PARTS[@]}")
					UNSAVED_CHANGES=true
					return 0
				fi ;;
			back) return 0 ;;
		esac
	done
}

function manual_apply_preset() {
	menu_radiolist_labeled "Presets" "Replace the partition list with a ready-made layout." "swap_root" \
		"swap_root"  "Swap + root (everything else on /)" \
		"swap_home"  "Swap + root + separate /home (survives reinstalls)" \
		"root_only"  "Root only (no swap)" || return 0
	local swap root_size disk_mib
	swap="$(format_mib "$(plan_swap_mib auto)" | sed -e 's/\.0 / /' -e 's/ //')"
	root_size="40GiB"
	if disk_mib="$(disk_size_mib "$PARTITIONING_DEVICE")"; then
		# a third of the disk for / (between 30 and 100 GiB)
		local gib=$((disk_mib / 1024 / 3))
		[[ $gib -lt 30 ]] && gib=30
		[[ $gib -gt 100 ]] && gib=100
		root_size="${gib}GiB"
	fi
	case "$dialog_out" in
		swap_root) PARTITIONING_MANUAL_PARTS=("$swap:swap:swap" "remaining:/:ext4") ;;
		swap_home) PARTITIONING_MANUAL_PARTS=("$swap:swap:swap" "$root_size:/:ext4" "remaining:/home:ext4") ;;
		root_only) PARTITIONING_MANUAL_PARTS=("remaining:/:ext4") ;;
	esac
	UNSAVED_CHANGES=true
}

function PARTITIONING_MANUAL_menu_editor() {
	local choice
	while true; do
		local items=() i size mount fs luks
		local boot_text
		boot_text="$(printf '%-24s %-10s %-6s %s' "$([[ $PARTITIONING_BOOT_TYPE == efi ]] && echo "EFI system partition" || echo "BIOS boot partition")" "$PARTITIONING_MANUAL_BOOT_SIZE" "FAT32" "$([[ $PARTITIONING_BOOT_TYPE == efi ]] && echo /boot || echo /boot/bios)")"
		items+=("boot" "1  $boot_text")
		for i in "${!PARTITIONING_MANUAL_PARTS[@]}"; do
			size="$(manual_row_get "$i" 1)"; mount="$(manual_row_get "$i" 2)"
			fs="$(manual_row_get "$i" 3)"; luks="$(manual_row_get "$i" 4)"
			items+=("$i" "$((i + 2))  $(printf '%-24s %-10s %-6s %s' "$([[ $mount == swap ]] && echo "Swap" || echo "$mount")" "$size" "$fs" "${luks:+(LUKS)}")")
		done
		items+=("add" "+  Add a partition" "preset" "↺  Start from a preset layout" "done" "✔  Done")

		manual_validate
		local disk_line free_line="" disk_mib=""
		if disk_mib="$(disk_size_mib "$PARTITIONING_DEVICE")"; then
			disk_line="Disk: $(shorten_device "$PARTITIONING_DEVICE")  ($(format_mib "$disk_mib"))"
		else
			disk_line="Disk: \\Z1$(shorten_device "$PARTITIONING_DEVICE") (not found - choose the disk in the main menu first)\\Zn"
		fi
		local problems=""
		[[ -n $disk_mib ]] || PLAN_PROBLEMS+=("No disk selected yet.")
		if [[ ${#PLAN_PROBLEMS[@]} -gt 0 ]]; then
			problems="\\n\\Z1$(printf '! %s\\n' "${PLAN_PROBLEMS[@]}")\\Zn"
		else
			problems="\\n\\Z2Layout is valid.\\Zn"
		fi
		dialog --title " Custom partitioning " --no-tags --cancel-label "Done" --ok-label "Edit" \
			--default-item "${choice:-boot}" \
			--menu "$disk_line\\nThe whole disk is erased. Select a partition to edit it; the last one may use 'remaining'.\\n$problems" \
			"$(( (${#items[@]} / 2 + 11) > MENU_SIZE[0] ? MENU_SIZE[0] : (${#items[@]} / 2 + 11) ))" "${MENU_SIZE[1]}" "$((${#items[@]} / 2))" "${items[@]}" || return 0
		choice="$dialog_out"
		case "$choice" in
			boot)
				if manual_pick_size "$PARTITIONING_MANUAL_BOOT_SIZE" && [[ $dialog_out != remaining ]]; then
					PARTITIONING_MANUAL_BOOT_SIZE="$dialog_out"
					UNSAVED_CHANGES=true
				fi ;;
			add)    manual_add_partition ;;
			preset) manual_apply_preset ;;
			done)   return 0 ;;
			*)      manual_edit_row "$choice" ;;
		esac
	done
}

################################################
# Review screen and dynamic title

function review_text() {
	echo "DISK"
	partition_plan_text
	echo
	echo "BOOT        $([[ $PARTITIONING_BOOT_TYPE == bios ]] && echo "syslinux (BIOS)" || echo "$BOOTLOADER (EFI)")"
	echo
	echo "SYSTEM      host '$HOSTNAME', timezone $TIMEZONE, keymap $KEYMAP, locale $LOCALE"
	echo "ACCOUNTS    root: $ROOT_PASSWORD_MODE; user: ${USER_NAME:-none}$([[ -n $USER_NAME && $USER_SUDO == true ]] && echo " (sudo)")"
	if [[ $DESKTOP == none ]]; then
		echo "DESKTOP     none (console only)"
	else
		echo "DESKTOP     $(desktop_name), login screen: $(display_manager_name)"
	fi
	echo "NETWORK     $NETWORK_BACKEND"
	echo "EXHERBO     everything is compiled from source with cave (no binary packages); expect hours"
}

function update_backtitle() {
	local disk="no disk"
	case "$PARTITIONING_SCHEME" in
		classic_single_disk|manual|existing_partitions)
			[[ -e ${PARTITIONING_DEVICE:-} ]] && disk="$(basename "$(shorten_device "$PARTITIONING_DEVICE")")" ;;
		zfs_centric|btrfs_centric|raid0_luks) disk="${#PARTITIONING_DEVICES[@]} disks" ;;
		custom) disk="custom layout" ;;
	esac
	local boot
	if [[ ${PARTITIONING_BOOT_TYPE:-efi} == bios ]]; then boot="BIOS/GRUB"; else boot="EFI/$BOOTLOADER"; fi
	BACKTITLE="Exherbo Forge  ▸  $disk  ▸  $boot  ▸  $([[ $DESKTOP == none ]] && echo "console" || desktop_name)  ▸  $NETWORK_BACKEND$([[ $UNSAVED_CHANGES == true ]] && echo "  ●unsaved")"
}

# Section header rows in the main menu (reverse video bars)
function section_tag()   { printf '━━ %s ━━' "$1"; }
function section_label() { local rule; rule="$(printf '━%.0s' {1..120})"; printf '\\Z5%s\\Zn' "$rule"; }

