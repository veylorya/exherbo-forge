# ---- Accounts ----------------------------------------------------------

function ROOT_PASSWORD_MODE_tag()   { echo "Root account"; }
function ROOT_PASSWORD_MODE_label() {
	case "$ROOT_PASSWORD_MODE" in
		set)    echo "(password)" ;;
		locked) echo "(locked, use sudo)" ;;
		ask)    echo "(ask during install)" ;;
	esac
}
function ROOT_PASSWORD_MODE_show()  { return 0; }
function ROOT_PASSWORD_MODE_help()  { echo "How the root account is handled. 'password' stores a salted SHA-512 hash of the password you enter here (never the password itself). 'locked' disables root login completely; you then administer the system with sudo from your user account (a user is required). 'ask' prompts for the root password when the installation starts."; }
function ROOT_PASSWORD_MODE_menu()  {
	if menu_radiolist_labeled \
		"Root account" \
		"How should the root account be set up?" \
		"$ROOT_PASSWORD_MODE" \
		"set"    "Set a root password now" \
		"locked" "Lock root, administer via sudo (needs a user account)" \
		"ask"    "Ask for the root password during the installation"
	then
		ROOT_PASSWORD_MODE="$dialog_out"
		UNSAVED_CHANGES=true
	fi
}

# $1: title, $2: variable name receiving the hash
function ask_password_hash() {
	local title="$1" var="$2" pw1 pw2
	type openssl &>/dev/null \
		|| { dialog --msgbox "openssl is required to hash passwords, but is not installed in this environment." 7 60; return 1; }
	while true; do
		dialog --insecure --title "$title" --passwordbox "Enter a password (at least 6 characters). Leave empty to cancel." 9 "${INPUTBOX_SIZE[1]}" \
			|| return 1
		pw1="$dialog_out"
		[[ -n $pw1 ]] || return 1
		if [[ ${#pw1} -lt 6 ]]; then
			dialog --msgbox "The password must be at least 6 characters long." 7 56
			continue
		fi
		dialog --insecure --title "$title" --passwordbox "Repeat the password." 9 "${INPUTBOX_SIZE[1]}" \
			|| return 1
		pw2="$dialog_out"
		if [[ $pw1 != "$pw2" ]]; then
			dialog --msgbox "The passwords do not match. Please try again." 7 56
			continue
		fi
		declare -g "$var"="$(hash_password "$pw1")"
		return 0
	done
}

function ROOT_PASSWORD_tag()   { echo " └ Root password"; }
function ROOT_PASSWORD_label() { echo " └ ($([[ -n $ROOT_PASSWORD_HASH ]] && echo "set" || echo "\Z1not set\Zn"))"; }
function ROOT_PASSWORD_show()  { [[ $ROOT_PASSWORD_MODE == "set" ]]; }
function ROOT_PASSWORD_help()  { echo "The root password. Only a salted SHA-512 hash is written to the configuration file. If you leave it unset, the installer asks for the password when it runs."; }
function ROOT_PASSWORD_menu()  {
	ask_password_hash "Root password" ROOT_PASSWORD_HASH \
		&& UNSAVED_CHANGES=true
}

function USER_NAME_tag()   { echo "User account"; }
function USER_NAME_label() { echo "($([[ -n $USER_NAME ]] && echo "$USER_NAME" || echo "none"))"; }
function USER_NAME_show()  { return 0; }
function USER_NAME_help()  { echo "Creates a regular user with a home directory, in the groups wheel, audio, video, usb, plugdev, input and render (where they exist). Leave empty to create no user."; }
function USER_NAME_menu()  {
	dialog \
		--title "User account" \
		--inputbox "Enter the user name (lowercase letters, digits, - and _). Leave empty for no user." \
		"${INPUTBOX_SIZE[@]}" "$USER_NAME" \
		|| return 0
	local name="$dialog_out"
	if [[ -n $name && ! $name =~ ^[a-z_][a-z0-9_-]{0,31}$ || $name == "root" ]]; then
		dialog --msgbox "'$name' is not a valid user name." 7 56
		return 0
	fi
	USER_NAME="$name"
	UNSAVED_CHANGES=true
}

function USER_PASSWORD_tag()   { echo " ├ Password"; }
function USER_PASSWORD_label() { echo " ├ ($([[ -n $USER_PASSWORD_HASH ]] && echo "set" || echo "\Z1not set\Zn"))"; }
function USER_PASSWORD_show()  { [[ -n $USER_NAME ]]; }
function USER_PASSWORD_help()  { echo "The password of the user account. Only a salted SHA-512 hash is written to the configuration file. If you leave it unset, the installer asks for the password when it runs."; }
function USER_PASSWORD_menu()  {
	ask_password_hash "Password for $USER_NAME" USER_PASSWORD_HASH \
		&& UNSAVED_CHANGES=true
