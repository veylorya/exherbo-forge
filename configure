function INSTALL_NOW_tag()   { echo ">> Review and install"; }
function INSTALL_NOW_label() { echo "(starts ./install)"; }
function INSTALL_NOW_show()  { return 0; }
function INSTALL_NOW_help()  { echo "Saves this configuration and starts the installation right away. You will be shown the partitioning plan and asked to confirm before any disk is changed."; }
function INSTALL_NOW_menu()  {
	local problems=()
	[[ $EUID == 0 ]] || problems+=("The installer must be run as root.")
	if [[ $PARTITIONING_SCHEME == "custom" ]]; then
		:
	elif one_of "$PARTITIONING_SCHEME" "classic_single_disk" "manual"; then
		partition_plan_text >/dev/null
		local pp
		for pp in "${PLAN_PROBLEMS[@]}"; do problems+=("$pp"); done
	elif one_of "$PARTITIONING_SCHEME" "existing_partitions"; then
		[[ -e $PARTITIONING_DEVICE ]] || problems+=("The target device '$PARTITIONING_DEVICE' does not exist. Choose it under 'Partitioning scheme'.")
	fi
	if [[ -z $USER_NAME && $ROOT_PASSWORD_MODE == "locked" ]]; then
		problems+=("Root is locked and there is no user account: you could never log in.")
	fi
	if [[ ${#problems[@]} -gt 0 ]]; then
		dialog --title "Cannot install yet" --msgbox "$(printf '* %s\n' "${problems[@]}")" 12 "${CONFIRM_SIZE[1]}"
		return 0
	fi
	local review_file
	review_file="$(mktemp)"
	review_text > "$review_file"
	dialog --title " Review " --exit-label "Continue" --textbox "$review_file" "${MENU_SIZE[0]}" "${MENU_SIZE[1]}"
	rm -f "$review_file"
	dialog --title "Start installation" --yes-label "Install" --no-label "Back" \
		--yesno "Save the configuration to $RELA_CONFIG_FILE and start the installation now?\n\nNothing is changed on any disk until you confirm the partitioning plan in the next step." 11 "${CONFIRM_SIZE[1]}" \
		|| return 0
	# The installer needs the config inside its own directory (it is also read from within the chroot).
	local install_conf="$CONFIG_FILE"
	if [[ $install_conf != "$GENTOO_INSTALL_REPO_DIR"/* ]]; then
		install_conf="$GENTOO_INSTALL_REPO_DIR/exherbo.conf"
		if [[ -e $install_conf ]] && ! dialog --defaultno --yesno "The configuration lives outside the installer directory, so it must be copied to $install_conf, which already exists. Overwrite it?" 9 "${CONFIRM_SIZE[1]}"; then
			return 0
		fi
	fi
	save "$CONFIG_FILE"
	[[ $install_conf == "$CONFIG_FILE" ]] || save "$install_conf"
	UNSAVED_CHANGES=false
	gentoo_theme_reset
	clear -x
	exec "$GENTOO_INSTALL_REPO_DIR/install" --config "$install_conf"
}


################################################
# Menu functions

# $1: filename
function save() {
	if [[ "$KEYMAP_INITRAMFS_OTHER" == "false" ]]; then
		KEYMAP_INITRAMFS="$KEYMAP"
	fi

	cat > "$1" <<EOF
# vim: set ft=sh ts=4 sw=4 sts=-1 noet:
# This file will be interpreted by /bin/bash.


################################################
# Disk configuration

$(define_disk_layout)


################################################
# System configuration

HOSTNAME=${HOSTNAME@Q}
TIMEZONE=${TIMEZONE@Q}
KEYMAP=${KEYMAP@Q}
KEYMAP_INITRAMFS=${KEYMAP_INITRAMFS@Q}

LOCALES=${LOCALES@Q}
LOCALE=${LOCALE@Q}

NETWORK_BACKEND=${NETWORK_BACKEND@Q}
COPY_LIVE_WIFI=${COPY_LIVE_WIFI@Q}
SYSTEMD_NETWORKD_INTERFACE_NAME=${SYSTEMD_NETWORKD_INTERFACE_NAME@Q}
SYSTEMD_NETWORKD_DHCP=${SYSTEMD_NETWORKD_DHCP@Q}
SYSTEMD_NETWORKD_ADDRESSES=(${SYSTEMD_NETWORKD_ADDRESSES[@]@Q})
SYSTEMD_NETWORKD_GATEWAY=${SYSTEMD_NETWORKD_GATEWAY@Q}


################################################
# Accounts (passwords are stored as salted SHA-512 hashes, never in clear text)

ROOT_PASSWORD_MODE=${ROOT_PASSWORD_MODE@Q}
ROOT_PASSWORD_HASH=${ROOT_PASSWORD_HASH@Q}
USER_NAME=${USER_NAME@Q}
USER_PASSWORD_HASH=${USER_PASSWORD_HASH@Q}
USER_SUDO=${USER_SUDO@Q}


################################################
# Desktop

BOOTLOADER=${BOOTLOADER@Q}
DESKTOP=${DESKTOP@Q}
DISPLAY_MANAGER=${DISPLAY_MANAGER@Q}


################################################
# Exherbo configuration

EXHERBO_STAGE_URL=${EXHERBO_STAGE_URL@Q}
EXHERBO_REPOSITORIES=${EXHERBO_REPOSITORIES@Q}
KERNEL_CONFIG=${KERNEL_CONFIG@Q}
SYSTEMD=true


################################################
# Additional (optional) configuration

ADDITIONAL_PACKAGES=(${ADDITIONAL_PACKAGES[@]@Q})


################################################
# Prove that you have read the config

I_HAVE_READ_AND_EDITED_THE_CONFIG_PROPERLY=true
EOF
}

trap 'clear_and_exit 130' SIGINT

# Begin menu loop. Exit will be called to end this loop where it is appropriate.
SELECTED_MENU_ITEM="$(PARTITIONING_SCHEME_tag)"
while true; do
	menu
done
