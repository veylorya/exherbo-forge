function PARTITIONING_SCHEME_tag()   { echo "Partitioning scheme"; }
function PARTITIONING_SCHEME_label() {
	case "$PARTITIONING_SCHEME" in
		classic_single_disk) echo "(recommended: auto-sized single disk)" ;;
		manual)              echo "(custom partitioning)" ;;
		existing_partitions) echo "(existing partitions)" ;;
		zfs_centric)         echo "(ZFS)" ;;
		btrfs_centric)       echo "(btrfs multi-disk)" ;;
		raid0_luks)          echo "(raid0 + LUKS)" ;;
		custom)              echo "(expert: hand-written)" ;;
		*)                   echo "($PARTITIONING_SCHEME)" ;;
	esac
}
function PARTITIONING_SCHEME_show()  { return 0; }
function PARTITIONING_SCHEME_help()  { echo "Select the desired partitioning scheme."; }
function PARTITIONING_SCHEME_menu()  {
	if menu_radiolist_labeled \
		"Select partitioning scheme" \
		"Select which partitioning scheme you want to follow. Have a look at the help text for this option (available in the menu) for more details.\n\nAll options support EFI/BIOS and swap. (Disk encryption, RAID and ZFS are not supported by the Exherbo installer yet.)\n" \
		"$PARTITIONING_SCHEME" \
		"${ALL_PARTITIONING_SCHEMES[@]}"
	then
		# Set disk scheme (the already selected disk is kept)
		local prev_disk="${PARTITIONING_DEVICE:-}"
		[[ -n $prev_disk ]] || prev_disk="${PARTITIONING_DEVICES[0]:-/dev/sdX}"
		local prev_type="${PARTITIONING_BOOT_TYPE:-$DEFAULT_BOOT_TYPE}"
		case "$dialog_out" in
			"classic_single_disk") create_classic_single_disk_layout swap=auto type="$prev_type" luks=false root_fs=btrfs subvolumes=true "$prev_disk" ;;
			"manual")              create_manual_layout type="$prev_type" parts="$(manual_default_parts "$prev_disk")" "$prev_disk" ;;
			"existing_partitions") create_existing_partitions_layout boot=/dev/sdA swap=false type="$prev_type" "$prev_disk" ;;
			"zfs_centric")         create_zfs_centric_layout swap=auto type="$prev_type" encrypt=true compress=zstd pool_type=standard "$prev_disk" ;;
			"btrfs_centric")       create_btrfs_centric_layout swap=auto type="$prev_type" raid_type=raid0 luks=false "$prev_disk" ;;
			"raid0_luks")          create_raid0_luks_layout swap=auto type="$prev_type" root_fs=ext4 "$prev_disk" /dev/sdY ;;
			"custom")              PARTITIONING_SCHEME="$dialog_out" ;;
		esac
		UNSAVED_CHANGES=true
	else
		# Return to menu
		true
	fi
}

